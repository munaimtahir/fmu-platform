        "/api/people/addresses/",
        "/api/people/addresses/{id}/",
        "/api/people/contact-info/",
        "/api/people/contact-info/{id}/",
        "/api/people/identity-documents/",
        "/api/people/identity-documents/{id}/",
        "/api/people/persons/",
        "/api/people/persons/{id}/"
      ],
      "writes": [
        "create/edit/delete person",
        "manage contact info, addresses, identity documents",
        "upload photo"
      ],
      "services": [
        "services/people.ts"
      ],
      "pages": [
        "pages/people/PeopleListPage.tsx",
        "pages/people/PersonDetailPage.tsx"
      ],
      "tests": ["workflowSmoke.test.tsx"],
      "permissions": [
        "people.persons.view",
        "people.persons.create",
        "people.persons.update",
        "people.persons.delete"
      ],
      "status": "implemented"
    },
