FROM node:20-alpine AS builder

# Set working directory
WORKDIR /app

# Configure build-time environment
ARG VITE_API_URL
ENV VITE_API_URL=${VITE_API_URL}
ARG VITE_PLATFORM_PROVIDER
ARG VITE_PLATFORM_NAME
ARG VITE_INSTITUTION_NAME
ARG VITE_INSTITUTION_SHORT_NAME
ARG VITE_INSTITUTION_LOGO
ARG VITE_INSTITUTION_EMAIL
ARG VITE_INSTITUTION_EMAIL_DOMAIN
ARG VITE_INSTITUTION_PRIMARY_COLOR
ARG VITE_INSTITUTION_SECONDARY_COLOR
ARG VITE_INSTITUTION_TYPE
ARG VITE_PUBLIC_APP_DOMAIN
ENV VITE_PLATFORM_PROVIDER=${VITE_PLATFORM_PROVIDER}
ENV VITE_PLATFORM_NAME=${VITE_PLATFORM_NAME}
ENV VITE_INSTITUTION_NAME=${VITE_INSTITUTION_NAME}
ENV VITE_INSTITUTION_SHORT_NAME=${VITE_INSTITUTION_SHORT_NAME}
ENV VITE_INSTITUTION_LOGO=${VITE_INSTITUTION_LOGO}
ENV VITE_INSTITUTION_EMAIL=${VITE_INSTITUTION_EMAIL}
ENV VITE_INSTITUTION_EMAIL_DOMAIN=${VITE_INSTITUTION_EMAIL_DOMAIN}
ENV VITE_INSTITUTION_PRIMARY_COLOR=${VITE_INSTITUTION_PRIMARY_COLOR}
ENV VITE_INSTITUTION_SECONDARY_COLOR=${VITE_INSTITUTION_SECONDARY_COLOR}
ENV VITE_INSTITUTION_TYPE=${VITE_INSTITUTION_TYPE}
ENV VITE_PUBLIC_APP_DOMAIN=${VITE_PUBLIC_APP_DOMAIN}

# Copy package files
COPY package*.json ./

# Install all dependencies (including dev dependencies needed for build)
RUN npm ci --include=dev

# Copy project files
COPY . .

# Build the application
RUN npm run build

# Production stage - serve with nginx
FROM nginx:alpine

# Copy built files from builder
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy custom nginx config for SPA routing
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Expose port
EXPOSE 80

# Start nginx
CMD ["nginx", "-g", "daemon off;"]
